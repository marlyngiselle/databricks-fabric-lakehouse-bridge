# Copy to terraform.tfvars and replace every value. All IDs below are placeholders.
# The client secret is never written here: export TF_VAR_fabric_reader_secret instead.

environment     = "dev"
databricks_host = "https://adb-1234567890123456.7.azuredatabricks.net"

access_connector_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-lakehouse-dev/providers/Microsoft.Databricks/accessConnectors/ac-lakehouse-dev"
storage_account_id  = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-lakehouse-dev/providers/Microsoft.Storage/storageAccounts/stbridgedev"

pipeline_principal = "11111111-1111-1111-1111-111111111111"
entra_tenant_id    = "22222222-2222-2222-2222-222222222222"

fabric_reader = {
  application_id = "33333333-3333-3333-3333-333333333333"
  object_id      = "44444444-4444-4444-4444-444444444444"
}

fabric_capacity_id = "55555555-5555-5555-5555-555555555555"

fabric_workspace_roles = [
  { principal_id = "66666666-6666-6666-6666-666666666666", principal_type = "Group", role = "Admin" },
  { principal_id = "77777777-7777-7777-7777-777777777777", principal_type = "Group", role = "Contributor" },
  { principal_id = "88888888-8888-8888-8888-888888888888", principal_type = "Group", role = "Viewer" },
]

deploy_semantic_model = false
